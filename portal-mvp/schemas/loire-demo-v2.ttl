@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix s: <urn:portal:shape:> .
@prefix vc: <https://www.w3.org/2018/credentials#> .
@prefix gx: <https://w3id.org/gaia-x/development#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
s:VC a sh:NodeShape; sh:nodeKind sh:IRI; sh:class vc:VerifiableCredential;
 sh:property [sh:path vc:issuer; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI];
 sh:property [sh:path vc:credentialSubject; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI];
 sh:property [sh:path vc:validFrom; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:dateTime];
 sh:property [sh:path vc:validUntil; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:dateTime].
s:Address sh:class gx:Address; sh:property [sh:path gx:countryCode; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:pattern "^[A-Z]{2}$"].
s:LegalPerson a sh:NodeShape; sh:node s:VC;
 sh:property [sh:path vc:credentialSubject; sh:node [
 sh:property [sh:path schema:name; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1];
 sh:property [sh:path gx:registrationNumber; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI];
 sh:property [sh:path gx:legalAddress; sh:minCount 1; sh:maxCount 1; sh:node s:Address];
 sh:property [sh:path gx:headquartersAddress; sh:minCount 1; sh:maxCount 1; sh:node s:Address]]].
s:Issuer a sh:NodeShape; sh:node s:VC;
 sh:property [sh:path vc:credentialSubject; sh:node [sh:property [sh:path gx:gaiaxTermsAndConditions; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:pattern "^[a-f0-9]{64}$"]]].
s:LeiCode a sh:NodeShape; sh:node s:VC;
 sh:property [sh:path vc:credentialSubject; sh:node [
 sh:property [sh:path schema:leiCode; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:pattern "^[A-Z0-9]{18}[0-9]{2}$"];
 sh:property [sh:path gx:countryCode; sh:minCount 1; sh:maxCount 1; sh:pattern "^[A-Z]{2}$"];
 sh:property [sh:path gx:subdivisionCountryCode; sh:minCount 1; sh:maxCount 1; sh:pattern "^[A-Z]{2}-[A-Z0-9]{1,3}$"]]].
s:LabelCredential a sh:NodeShape; sh:node s:VC;
 sh:property [sh:path vc:credentialSubject; sh:node [
 sh:property [sh:path gx:labelLevel; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1];
 sh:property [sh:path gx:rulesVersion; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1];
 sh:property [sh:path gx:engineVersion; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1];
 sh:property [sh:path gx:compliantCredentials; sh:minCount 3; sh:maxCount 3; sh:nodeKind sh:IRI; sh:or (
   [sh:property [sh:path gx:digestSRI; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256-([a-f0-9]{64}|[A-Za-z0-9+/]{43}=)$"]]
   [sh:property [sh:path vc:digestSRI; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256-([a-f0-9]{64}|[A-Za-z0-9+/]{43}=)$"]])];
 sh:property [sh:path gx:validatedCriteria; sh:minCount 1]]].
